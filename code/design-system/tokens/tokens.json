{
  "$description": "Micah Hoang design tokens. Source of truth for code/design-system. Format: W3C Design Tokens (DTCG) with $value/$type. Values were measured from the published micahhoang.com and the Framer text/color styles on 2026-10-01. Edit here, then run `node build.mjs` to regenerate tokens.css. Supersedes code/tokens/micahhoang-tokens.json (Manrope era, stale).",
  "color": {
    "$type": "color",
    "primitive": {
      "cream": {
        "$value": "#F7F5F0",
        "$description": "Framer style /Cream. Page background, text on Forest Green."
      },
      "forest-green": {
        "$value": "#233324",
        "$description": "Framer style /Forest Green. Brand color: headings, nav, mono labels; inverse surface for footer and boot loader."
      },
      "accent-green": {
        "$value": "#25593A",
        "$description": "Not a Framer color style: set per instance as HomeSelectedWorkGrid tagHoverColor and IndexPage hover/active (rgb(37, 89, 58)). Hover/active only, never a fill."
      },
      "near-black": {
        "$value": "#141414",
        "$description": "Framer style /Off-Black. Rules, dividers, index list text, lightbox chrome, strong body."
      },
      "graphite": {
        "$value": "#525252",
        "$description": "Framer style /Text Gray. Long-form body copy on case studies."
      },
      "light-gray": {
        "$value": "#979797",
        "$description": "Framer style /Stroke Gray. Secondary headline line, tag text, thumbnail stroke."
      },
      "white": {
        "$value": "#FFFFFF",
        "$description": "Framer style /White. Lightbox backdrop, media placeholder."
      },
      "white-60": {
        "$value": "#FFFFFF99",
        "$description": "Muted text on Forest Green."
      },
      "grain-umber": {
        "$value": "#501D07",
        "$description": "Grain overlay tint. Used only in the texture layer."
      }
    },
    "cream": {
      "$description": "Semantic roles on the default Cream surface (data-surface=\"cream\").",
      "bg": {
        "page": {
          "$value": "{color.primitive.cream}",
          "$description": "Body and page background."
        },
        "inverse": {
          "$value": "{color.primitive.forest-green}",
          "$description": "Footer, boot loader, any inverted block."
        },
        "media": {
          "$value": "{color.primitive.white}",
          "$description": "Placeholder behind media before it loads; lightbox backdrop."
        },
        "hover": {
          "$value": "#1414140A",
          "$description": "Row hover wash (near-black at ~3.5%)."
        }
      },
      "text": {
        "brand": {
          "$value": "{color.primitive.forest-green}",
          "$description": "Display type, nav, mono labels, section headers."
        },
        "strong": {
          "$value": "{color.primitive.near-black}",
          "$description": "Lead body, metadata values, index rows, H3."
        },
        "body": {
          "$value": "{color.primitive.graphite}",
          "$description": "Long-form paragraphs."
        },
        "muted": {
          "$value": "{color.primitive.light-gray}",
          "$description": "Second headline line, tags, tertiary meta."
        },
        "interactive": {
          "$value": "{color.primitive.accent-green}",
          "$description": "Hover and active state for tags, filters, toggles."
        }
      },
      "border": {
        "rule": {
          "$value": "{color.primitive.near-black}",
          "$description": "1px full-width rules and dividers."
        },
        "stroke": {
          "$value": "{color.primitive.light-gray}",
          "$description": "Tag outline, optional 1px media stroke."
        }
      }
    },
    "green": {
      "$description": "Semantic roles on the Forest Green surface (data-surface=\"green\").",
      "bg": {
        "page": {
          "$value": "{color.primitive.forest-green}"
        },
        "inverse": {
          "$value": "{color.primitive.cream}"
        },
        "media": {
          "$value": "{color.primitive.white}"
        },
        "hover": {
          "$value": "#F7F5F014"
        }
      },
      "text": {
        "brand": {
          "$value": "{color.primitive.cream}"
        },
        "strong": {
          "$value": "{color.primitive.cream}"
        },
        "body": {
          "$value": "{color.primitive.white-60}"
        },
        "muted": {
          "$value": "{color.primitive.white-60}"
        },
        "interactive": {
          "$value": "{color.primitive.white}"
        }
      },
      "border": {
        "rule": {
          "$value": "{color.primitive.cream}"
        },
        "stroke": {
          "$value": "{color.primitive.white-60}"
        }
      }
    }
  },
