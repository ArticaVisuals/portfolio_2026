  "motion": {
    "ease": {
      "$type": "cubicBezier",
      "snappy": {
        "$value": [
          0.16,
          1,
          0.3,
          1
        ],
        "$description": "Default. Decelerating ease-out for reveals, hover transforms, media scale, fades."
      },
      "smooth": {
        "$value": [
          0.12,
          0.23,
          0.5,
          1
        ],
        "$description": "Symmetric: line/rule draws, small UI state changes, row hover wash."
      },
      "springy": {
        "$value": [
          0.25,
          1,
          0.5,
          1
        ],
        "$description": "Gesture-only (cursor trails, Line Animation draw). Do not use for UI state."
      }
    },
    "duration": {
      "$type": "duration",
      "instant": {
        "$value": "150ms",
        "$description": "Row hover wash."
      },
      "fast": {
        "$value": "250ms",
        "$description": "Color changes (tag hover)."
      },
      "zoom": {
        "$value": "260ms",
        "$description": "Lightbox zoom."
      },
      "base": {
        "$value": "420ms",
        "$description": "Hover transforms: flip rail, media scale."
      },
      "slow": {
        "$value": "620ms",
        "$description": "Index flip rail, media fade-in."
      },
      "reveal": {
        "$value": "900ms",
        "$description": "Type mask reveal; also scroll-to-top travel."
      },
      "page": {
        "$value": "1200ms",
        "$description": "Boot curtain lift / page transition."
      },
      "draw": {
        "$value": "2000ms",
        "$description": "Rule line draw (200ms delay)."
      }
    },
    "stagger": {
      "$type": "duration",
      "reveal": {
        "$value": "90ms"
      },
      "media": {
        "$value": "58ms"
      }
    },
    "distance": {
      "$type": "dimension",
      "reveal": {
        "$value": "115%",
        "$description": "Type mask hidden start (translateY)."
      },
      "flip-gap": {
        "$value": "5px",
        "$description": "Gap between stacked copies in the flip rail."
      }
    },
    "scale": {
      "$type": "number",
      "hover": {
        "$value": 1.02,
        "$description": "Media scale on card hover."
      }
    },
    "spring": {
      "$description": "For NEW gesture-driven UI only (drag, swipe, sheets, anything the user can grab mid-flight). Existing live components keep their bezier curves. Apple's damping ratio + response model; in Motion/Framer Motion use { type: 'spring', bounce: 1 - damping, duration: response }.",
      "default": {
        "$type": "spring",
        "$value": {
          "damping": 1.0,
          "response": 0.4
        },
        "$description": "Critically damped, no overshoot. Repositioning, settling, snapping."
      },
      "quick": {
        "$type": "spring",
        "$value": {
          "damping": 1.0,
          "response": 0.3
        },
        "$description": "Small, close-range moves: toggles, thumbs, short slides."
      },
      "momentum": {
        "$type": "spring",
        "$value": {
          "damping": 0.8,
          "response": 0.4
        },
        "$description": "Only after a flick or throw carried velocity. Never for UI that just appeared."
      }
    },
    "gesture": {
      "$description": "Values the live /play archive already ships (ArchivePlayground.tsx). Reuse for new gesture UI; do not retune /play.",
      "tap-threshold": {
        "$type": "dimension",
        "$value": "18px",
        "$description": "Movement before a press becomes a drag."
      },
      "throw-friction": {
        "$type": "number",
        "$value": 0.85,
        "$description": "Velocity multiplier per 60fps frame (exponential decay, ~0.990 per ms, Apple's 'snappy' rate)."
      },
      "throw-min-speed": {
        "$type": "number",
        "$value": 220,
        "$description": "px/s below which a release does not throw."
      },
      "throw-max-speed": {
        "$type": "number",
        "$value": 5200,
        "$description": "px/s clamp."
      },
      "throw-velocity-scale": {
        "$type": "number",
        "$value": 1.75,
        "$description": "Release velocity multiplier."
      }
    }
  },
